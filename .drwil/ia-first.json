{
  "projectName": "drwil_com",
  "projectShort": "drwil_com",
  "lang": "en",
  "layers": [],
  "contractPrefixes": [
    "SEC",
    "QUA",
    "SITE"
  ],
  "tools": [
    "claude",
    "codex",
    "cursor",
    "gemini",
    "copilot"
  ],
  "ci": "github",
  "dirs": {
    "projects": "docs/projects",
    "intentions": "docs/intentions",
    "recipes": "docs/recipes",
    "contracts": "docs/contracts.md",
    "index": "docs/projects/pending.md"
  },
  "stack": [
    {
      "path": ".",
      "technos": [
        "Node.js"
      ]
    }
  ],
  "checks": [
    {
      "id": "APP-001",
      "name": "APP-001 order total tests",
      "run": "node --test --test-name-pattern \"APP-001\" \"tests/*.test.mjs\"",
      "paths": [
        "src/**",
        "tests/**",
        "package.json",
        ".drwil/ia-first.json"
      ]
    },
    {
      "id": "QUA-041",
      "name": "QUA-041 acceptance-criteria demonstration",
      "run": "node --test --test-name-pattern \"QUA-041\" \"tests/*.test.mjs\"",
      "paths": [
        "src/**",
        "tests/**",
        "docs/contracts.md",
        "package.json",
        ".drwil/ia-first.json",
        ".githooks/**"
      ]
    },
    {
      "id": "SITE-001",
      "name": "SITE-001 demonstration verdict tests",
      "run": "pnpm --dir website exec vitest run -t \"SITE-001\"",
      "paths": [
        "website/src/**",
        "website/tests/**",
        "website/e2e/**",
        "website/scripts/**",
        "website/package.json",
        "docs/contracts.md",
        ".drwil/ia-first.json"
      ]
    },
    {
      "id": "SITE-003",
      "name": "SITE-003 fallback and reduced-motion tests",
      "run": "pnpm --dir website exec playwright test -g \"SITE-003\"",
      "paths": [
        "website/src/**",
        "website/tests/**",
        "website/e2e/**",
        "website/scripts/**",
        "website/package.json",
        "docs/contracts.md",
        ".drwil/ia-first.json",
        "website/*.html",
        "website/*.ts",
        "website/public/**"
      ]
    },
    {
      "id": "SITE-004",
      "name": "SITE-004 build and language parity",
      "run": "pnpm --dir website build && pnpm --dir website exec vitest run -t \"SITE-004\"",
      "paths": [
        "website/src/**",
        "website/tests/**",
        "website/e2e/**",
        "website/scripts/**",
        "website/package.json",
        "docs/contracts.md",
        ".drwil/ia-first.json",
        "website/*.html",
        "website/*.ts"
      ]
    },
    {
      "id": "SITE-005",
      "name": "SITE-005 link check",
      "run": "pnpm --dir website check:links",
      "paths": [
        "website/src/**",
        "website/tests/**",
        "website/e2e/**",
        "website/scripts/**",
        "website/package.json",
        "docs/contracts.md",
        ".drwil/ia-first.json"
      ]
    }
  ],
  "scopeReminder": "blocking",
  "transitions": "human",
  "scopeGate": "warning",
  "newRequirements": "blocking",
  "layerPrefixes": [
    "app",
    "tests",
    "src",
    "scripts"
  ],
  "codePrefixes": [
    "scripts",
    ".githooks",
    "e2e",
    "website"
  ],
  "extraCodeFiles": [],
  "extraCodeGlobs": [
    "docker-compose*.yml"
  ],
  "ciFiles": [
    ".github/workflows/ia-first.yml"
  ],
  "mode": "full"
}
